#footer-wrap
  .minimal-footer
    .minimal-footer__identity
      if theme.footer.owner.enable
        - const year = new Date().getFullYear()
        span © #{theme.footer.owner.since || year}–#{year} #{config.author}
      span 总是学习，总在进步。
    nav.minimal-footer__links(aria-label='页脚导航')
      a(href='https://github.com/chagumu01' target='_blank' rel='noopener noreferrer') GitHub
      a(href=url_for('/friends/')) 友链
      a(href=url_for('/box/gallery/')) 画廊
      a(href=url_for('/comments/')) 留言
    if theme.footer.copyright
      .framework-info
        a(href='https://hexo.io' target='_blank' rel='noopener noreferrer') Hexo
        span ·
        a(href='https://butterfly.js.org' target='_blank' rel='noopener noreferrer') Butterfly
