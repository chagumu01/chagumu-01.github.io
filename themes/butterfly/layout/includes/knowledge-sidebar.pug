mixin topicBranch(category)
  - const children = site.categories.data.filter(c => c.parent === category._id).sort((a, b) => a.name.localeCompare(b.name))
  - const currentBranch = category.posts.data.some(p => p.path === page.path)
  details.minimal-tree-branch(open=currentBranch)
    summary
      span= category.name
      span.minimal-tree-count= category.length
    .minimal-tree-children
      if children.length
        each child in children
          +topicBranch(child)
      else
        nav.knowledge-post-sidebar__links(aria-label=category.name + '文章')
          each article in category.posts.sort('date', 1).data
            a(class={ 'is-current': article.path === page.path } aria-current=article.path === page.path ? 'page' : false href=url_for(article.path) title=article.title)= article.title

aside.knowledge-post-sidebar(data-knowledge-sidebar aria-label='文章分类导航')
  button.knowledge-post-sidebar__close(type='button' aria-label='关闭知识库侧边栏' title='收起导航' data-knowledge-sidebar-close)
    span.knowledge-post-sidebar__toggle-icon(aria-hidden='true')
  .knowledge-post-sidebar__brand
    span.knowledge-post-sidebar__mark
      i.fas.fa-book-open(aria-hidden='true')
    span 文章导航
  .minimal-topic-tree
    each category in site.categories.data.filter(c => !c.parent).sort((a, b) => a.name.localeCompare(b.name))
      +topicBranch(category)
  a.minimal-tree-all(href=url_for('/categories/')) 查看全部分类 →

button.knowledge-post-sidebar__reopen(type='button' aria-label='打开知识库侧边栏' title='打开文章导航' data-knowledge-sidebar-open)
  span.knowledge-post-sidebar__toggle-icon(aria-hidden='true')
  span.minimal-series-label 文章导航
