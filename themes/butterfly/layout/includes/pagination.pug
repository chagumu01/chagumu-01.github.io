-
  var options = {
    prev_text: '<i class="fas fa-chevron-left fa-fw"></i>',
    next_text: '<i class="fas fa-chevron-right fa-fw"></i>',
    mid_size: 1,
    escape: false
  }

if is_post()
  - let prev = theme.post_pagination === 1 ? page.prev : page.next
  - let next = theme.post_pagination === 1 ? page.next : page.prev
  nav#pagination.minimal-post-navigation(class={ 'minimal-post-navigation--single': !prev || !next } aria-label='文章上下篇导航')
    if(prev)
      a.minimal-post-nav__link(href=url_for(prev.path) rel='prev')
        span.minimal-post-nav__label ← #{_p('pagination.prev')}
        span.minimal-post-nav__title=prev.title
          
    if(next)
      a.minimal-post-nav__link.minimal-post-nav__link--next(href=url_for(next.path) rel='next')
        span.minimal-post-nav__label #{_p('pagination.next')} →
        span.minimal-post-nav__title=next.title
else
  nav#pagination
    if is_home()
      p.minimal-pagination-caption 第 #{page.current} / #{page.total} 页 · 每页 #{config.index_generator.per_page} 篇
    .pagination
      if is_home()
        - options.format = 'page/%d/#content-inner'
      !=paginator(options)
