nav#nav(aria-label='主导航')
  span#blog_name
    a#site-name(href=url_for('/'))
      img.minimal-brand-icon(src=url_for('/assets/brand-icon.png') alt='' width='28' height='28')
      span= config.title
  #menus
    !=partial('includes/header/menu_item', {}, {cache: true})
    #nav-right
      if (theme.algolia_search.enable || theme.local_search.enable)
        #search-button
          button.search(type='button' aria-label='搜索文章')
            i.fas.fa-search(aria-hidden='true')
            span 搜索
      button#nightmode-button(type='button' aria-label='切换深色模式' title='切换深色模式')
        i.fas.fa-moon(aria-hidden='true')
      #toggle-menu
        button(type='button' aria-label='打开导航菜单')
          i.fas.fa-bars.fa-fw(aria-hidden='true')
