extends includes/layout.pug

block content
  #recent-posts.recent-posts
    if page.current === 1
      section.minimal-intro
        p.minimal-eyebrow NOTES · IDEAS · LIFE
        h1
          span 总是学习，
          span 总在进步。
        p.minimal-intro__description 记录技术学习，也记录生活。把遇到的问题、理解的过程和新的想法，慢慢整理在这里。
        a.minimal-text-link(href=url_for('/about/')) 关于我 →
      section.minimal-topics(aria-labelledby='topics-title')
        .minimal-section-heading
          h2#topics-title 从一个专题开始
          a(href=url_for('/archives/')) 全部文章 →
        .minimal-topic-grid
          a.minimal-topic(href=url_for('/posts/e48005e0.html'))
            span.minimal-topic__number 01
            h3 大模型与 Agent
            p 从基础概念到 RAG、MCP 与 Agent 的学习笔记。
            span.minimal-topic__action 开始阅读 →
          a.minimal-topic(href=url_for('/java/core/'))
            span.minimal-topic__number 02
            h3 Java 学习资料
            p 整理基础知识与学习资料，在实践中积累理解。
            span.minimal-topic__action 浏览资料 →
          a.minimal-topic(href=url_for('/ai/path/'))
            span.minimal-topic__number 03
            h3 AI 学习路线
            p 收集大模型学习资源，寻找下一步的方向。
            span.minimal-topic__action 查看路线 →
    if page.current === 1
      section.home-console-grid(aria-label='博客终端与状态面板' data-home-dashboard data-posts=site.posts.length)
        .home-console-card
          .home-console-header
            span.home-console-label CMD
            span.home-console-caption chagumu@blog:~
          .home-console-body
            #home-command-output.home-command-output(role='log' aria-label='命令输出' aria-live='polite')
            form#home-command-form.home-command-form
              label(for='home-command-input') $
              input#home-command-input(type='text' placeholder='输入 help 查看命令' autocomplete='off' spellcheck='false' aria-label='博客终端命令')
              button(type='submit' aria-label='执行命令') ↵
        .home-console-card.home-monitor
          .home-console-header
            span.home-console-label SYS_MONITOR
            span.home-console-caption 模拟遥测
          .home-monitor-clock
            span#home-monitor-clock --:--:--
            span.home-monitor-zone 上海 / UTC+8
          .home-monitor-metrics
            each metric in ['CPU', 'MEM', 'NET']
              .home-monitor-metric
                .home-monitor-metric-label
                  span= metric
                  span(data-monitor-value=metric) —
                .home-monitor-bar
                  span(data-monitor-bar=metric)
          svg.home-monitor-wave(viewBox='0 0 300 32' preserveAspectRatio='none' aria-hidden='true')
            path#home-monitor-wave(fill='none' stroke='currentColor' stroke-width='1.5')
          .home-monitor-footer
            span SESSION
            span#home-monitor-uptime 00:00:00
    if page.current === 1
      - const writingDates = site.posts.sort('date', -1).data.map(article => ({ date: date(article.date, 'YYYY-MM-DD'), title: article.title, path: url_for(article.path) }))
      section.home-writing-calendar(data-writing-calendar aria-labelledby='writing-calendar-title')
        script.writing-calendar-data(type='application/json')!= JSON.stringify(writingDates).replace(/</g, '\\u003c')
        .home-writing-header
          div
            h2#writing-calendar-title 写作记录
            p#writing-calendar-summary 按文章发布日期记录
          select#writing-calendar-year(aria-label='选择写作记录年份')
        .home-writing-scroll
          .home-writing-months(aria-hidden='true')
          .home-writing-grid(aria-label='每日文章发布记录')
        .home-writing-footer
          span 点击有颜色的日期，查看当天文章。
          .home-writing-legend
            span 少
            each level in [0, 1, 2, 3, 4]
              span.home-writing-cell(data-level=level aria-hidden='true')
            span 多
        #writing-calendar-detail.home-writing-detail(aria-live='polite')
    section.minimal-articles(aria-labelledby='articles-title')
      .minimal-section-heading
        h2#articles-title= page.current === 1 ? '最新文章' : '文章 · 第 ' + page.current + ' 页'
        a(href=url_for('/archives/')) 文章归档 →
      each article in page.posts.data
        - const articleLink = article.link || article.path
        - const articleTitle = article.title || _p('no_title')
        - const summary = strip_html(article.description || article.excerpt || article.content).replace(/\s+/g, ' ').trim()
        article.minimal-article
          .minimal-article__meta
            time(datetime=date_xml(article.date))= date(article.date, 'YYYY-MM-DD')
            if article.categories.length
              span ·
              a(href=url_for(article.categories.data[0].path))= article.categories.data[0].name
            if article.sticky > 0 || article.top
              span.minimal-pill 置顶
          h3
            a(href=url_for(articleLink))= articleTitle
          if !article.password && !article.encrypt && summary
            p= summary.substring(0, 110) + (summary.length > 110 ? '…' : '')
          a.minimal-article__read(href=url_for(articleLink) aria-label='阅读：' + articleTitle) 阅读文章 →
    include includes/pagination.pug
